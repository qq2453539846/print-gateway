# 扫码打印网关 —— 环境变量样板
#
#   cp .env.example .env      # 然后按需取消注释并填写
#
# .env 已被 .gitignore 拦下，不会进仓库。docker compose 会自动读同目录的 .env。

# ── 基础 ──────────────────────────────────────────────────────────
TZ=Asia/Shanghai
TITLE=扫码打印
# 单文件上传上限（MB）
MAX_MB=50

# 管理页口令。留空 = /admin 整体关闭（本项目不提供无口令的管理页）
# ADMIN_TOKEN=换成你自己的口令

# 界面上展示的访问地址。多网卡机器建议显式指定，否则可能探测到错的那张网卡
# HOST_DISPLAY=192.168.1.10

# 宿主已经装好 CUPS 时填这一行：切到「模式 B」，容器内不再起 cupsd
# CUPS_SERVER=192.168.1.10:631

# ── 内网穿透（没有公网 IP / 也没有自有域名时的远程访问）────────────
#
# 启用：docker compose --profile tunnel up -d
# 只在启用时起作用；不启用则下面三个变量填不填都不影响内网部署。
#
# 三个都要填，缺一个公网实例会拒绝启动（宁可起不来，也不能公网免密）。

# 1) DDNSTO 令牌：登录 https://www.ddnsto.com/ ，控制台右上角复制
DDNSTO_TOKEN=

# 2) 公网实例的口令。内网 8080 依然免密，只有对外的 8081 这份要口令
PUBLIC_TOKEN=

# 3) DDNSTO 分配给你的地址，形如 https://abc123.kooldns.cn
#    拿到后到 DDNSTO 控制台加一条「域名映射」，目标填 http://<本机IP>:8081
PUBLIC_URL=

# 同一局域网里有多台设备跑 ddnsto 时改这个，避免设备 ID 撞车（1~100）
# DEVICE_IDX=0
