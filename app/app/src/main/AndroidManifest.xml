<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 扫码连接：扫打印网关的「带口令连接码」，本地解析出 host+口令一步配好 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      打印网关跑在局域网里、只提供 HTTP。
      Android 9（API 28）起默认禁止明文流量，不显式打开的话
      WebView 和上传都会以 "Cleartext HTTP traffic not permitted" 失败，
      且报错出现在 WebView 内部，从界面看不出是网络策略问题。
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 文件管理器 / 浏览器下载完成后点 PDF 的「打开方式」 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- 其他 App 里「分享到」 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 扫码连接：相机预览 + 本地识别，把「带口令连接码」解析成 host+口令 -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="@string/scan_title"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />
    </application>

    <!-- Android 11+ 的包可见性声明：没有它，部分 ROM 不会把本 App
         列进「打开方式」候选，或让本 App 无法枚举 PDF 阅读器。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

</manifest>
